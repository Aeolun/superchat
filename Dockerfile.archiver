# Build stage
FROM golang:1.24-alpine AS builder

# Install build dependencies
RUN apk add --no-cache git make

# Set working directory
WORKDIR /build

# Copy go mod files
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build argument for version (passed from build command)
ARG VERSION=dev

# Build the archiver binary with version
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -ldflags="-X main.Version=${VERSION}" -o superchat-archiver ./cmd/archiver

# Final stage - nginx + archiver binary
FROM nginx:alpine

# Copy archiver binary
COPY --from=builder /build/superchat-archiver /usr/local/bin/superchat-archiver
RUN chmod +x /usr/local/bin/superchat-archiver

# Copy nginx config for serving archive HTML
COPY docker/archiver/nginx.conf /etc/nginx/conf.d/default.conf

# Create data and output directories
RUN mkdir -p /data /usr/share/nginx/html/archive && \
    chown nginx:nginx /data /usr/share/nginx/html/archive

# Copy entrypoint
COPY docker/archiver/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Expose ports: 6470 = archive protocol, 80 = HTTP for static HTML
EXPOSE 6470 80

# Volumes: database + generated HTML (served by nginx)
VOLUME ["/data"]

ENTRYPOINT ["/entrypoint.sh"]
